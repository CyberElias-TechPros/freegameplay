# ──────────────────────────────────────────────────────────────────────────────
# FreeGameplay — environment template
# Copy to .env (repo root) for the deploy pipeline, or to apps/web/.env.local
# for local frontend development. NEVER commit real values.
#
# Everything marked OPTIONAL works without a key: the feature degrades to a
# documented, testable behaviour instead of breaking. Nothing here is required
# to run the stack locally.
# ──────────────────────────────────────────────────────────────────────────────

# ── Cloudflare (backend provisioning + deployment) ───────────────────────────
# API Token with: Workers Scripts (Edit), D1 (Edit), R2 (Write), KV (Edit),
# Account Settings (Read).
CLOUDFLARE_API_TOKEN=
# Optional. Leave empty to auto-discover the first account visible to the token.
CLOUDFLARE_ACCOUNT_ID=

# Worker name (keeps URLs predictable)
CF_WORKER_NAME=freegameplay-api

# D1 database name used by scripts/migrate.mjs and wrangler
CF_D1_NAME=freegameplay-db

# Admin API token for /api/admin/* endpoints.
# Leave empty and the deploy script will generate one for you.
ADMIN_TOKEN=

# ── Frontend (apps/web) ───────────────────────────────────────────────────────
# Base URL of the deployed content API (no trailing slash).
# Production: https://freegameplay-api.<subdomain>.workers.dev
# Local dev:  http://127.0.0.1:8787
API_BASE=http://127.0.0.1:8787

# Public site origin used in sitemaps / canonical / OG tags.
# Production: https://freegameplay.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AdSense (apps/web) ────────────────────────────────────────────────────────
# Publisher id from the AdSense account (Settings → Publisher ID, ca-pub-…).
# Leave EMPTY to run without ads (every slot renders a labelled placeholder
# and the CSP allows no ad origins at all).
NEXT_PUBLIC_ADSENSE_CLIENT=

# Port for the local frontend
WEB_PORT=3000

# Port for the local backend (wrangler dev)
API_PORT=8787

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — engagement + notifications. Each one has a safe default when
# unset; add the key when you are ready and the feature switches on.
# ──────────────────────────────────────────────────────────────────────────────

# Salt for the daily-rotating visitor hash used by analytics, comment
# rate-limiting and leaderboard de-duplication. Set to any long random string
# in production (e.g. `openssl rand -hex 32`). Unset = a fixed local-dev salt.
ANALYTICS_SALT=

# Transactional email (Resend or compatible). When BOTH are set, the app sends
# newsletter double opt-in confirmations and contact-form notifications.
# When unset, the confirmation link is returned by the API instead, so the
# whole flow still works and can be tested end to end.
RESEND_API_KEY=
# Envelope sender, must be a verified domain on your provider.
NOTIFY_FROM=FreeGameplay <hello@freegameplay.site>
# Where contact-form notifications are delivered.
NOTIFY_TO=

# Set to 1 to allow cron triggers to run during `wrangler dev` (they are off
# by default). Handy when testing the hourly sitemap refresh locally.
CRON_LOCAL=0
