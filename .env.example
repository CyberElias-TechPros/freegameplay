# ──────────────────────────────────────────────────────────────────────────────
# FreeGameplay — environment template
# Copy to .env (repo root) for the deployment scripts. For apps/web/.env.local,
# copy only frontend settings; never copy cloud/admin credentials. NEVER commit real values.
#
# Everything marked OPTIONAL works without a key: the feature degrades to a
# documented behavior instead of disclosing sensitive data. Generate local admin
# and analytics secrets in apps/api/.dev.vars using the README instructions.
# ──────────────────────────────────────────────────────────────────────────────

# ── Cloudflare (backend provisioning + deployment) ───────────────────────────
# API Token with: Workers Scripts (Edit), D1 (Edit), R2 (Write), KV (Edit),
# Account Settings (Read).
CLOUDFLARE_API_TOKEN=
# Required for remote operations. Explicit account selection prevents accidental writes.
CLOUDFLARE_ACCOUNT_ID=

# Worker name (keeps URLs predictable)
CF_WORKER_NAME=freegameplay-api

# D1 database name used by scripts/migrate.mjs and wrangler
CF_D1_NAME=freegameplay-db

# Admin API token for /api/admin/* endpoints.
# Required for remote apply: at least 32 random characters; never printed or auto-generated there.
ADMIN_TOKEN=

# ── Frontend (apps/web) ───────────────────────────────────────────────────────
# Base URL of the deployed content API (no trailing slash).
# Production: https://freegameplay-api.<subdomain>.workers.dev
# Local dev:  http://127.0.0.1:8787
API_BASE=http://127.0.0.1:8787

# Public site origin used in sitemaps / canonical / OG tags.
# Production: https://freegameplay.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AdSense (apps/web) ────────────────────────────────────────────────────────
# Publisher id from the AdSense account (Settings → Publisher ID, ca-pub-…).
# Leave EMPTY to run without ads (production slots are hidden). A publisher ID
# alone does not enable ads; reviewed configuration and consent gates also apply.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Port for the local frontend
WEB_PORT=3000

# Port for the local backend (wrangler dev)
API_PORT=8787

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — engagement + notifications. Each one has a safe default when
# unset; review rights/privacy/provider policy before enabling any optional feature.
# ──────────────────────────────────────────────────────────────────────────────

# Salt for the daily-rotating visitor hash used by analytics, comment
# rate-limiting and leaderboard identity. Required in production (at least 32
# random characters); production fails closed if missing.
ANALYTICS_SALT=

# Transactional email (Resend or compatible). When BOTH are set, the app sends
# newsletter double opt-in confirmations and contact-form notifications.
# Without a provider, production signup returns 503. Test links require BOTH
# APP_ENV=development and ALLOW_TEST_EMAIL_LINKS=1 in local .dev.vars only.
RESEND_API_KEY=
# Envelope sender, must be a verified domain on your provider.
NOTIFY_FROM=FreeGameplay <hello@freegameplay.site>
# Where contact-form notifications are delivered.
NOTIFY_TO=

# Set to 1 to allow cron triggers to run during `wrangler dev` (they are off
# by default). Handy when testing the hourly sitemap refresh locally.
CRON_LOCAL=0

# Security/release additions (2026-10-28)
# Production is the default. Set these ONLY in apps/api/.dev.vars for local tests:
# APP_ENV=development
# ALLOW_TEST_EMAIL_LINKS=1
# Production requires ADMIN_TOKEN + ANALYTICS_SALT. Never enable test links there.
# Operator-approved exact HTTPS feed hostnames, comma-separated (no wildcards).
# Empty disables URL fetching; XML file upload/import remains available.
FEED_ALLOWED_HOSTS=
# Ads remain off until provider/CMP/rights review is complete. Publisher ID alone
# is intentionally insufficient. This switch is not proof of legal compliance.
NEXT_PUBLIC_ADS_REVIEWED=0
# Backend canonical origin; must match the public frontend origin.
SITE_URL=https://freegameplay.site
