{
  "name": "freegameplay",
  "private": true,
  "version": "1.0.0",
  "description": "FreeGameplay.site — gaming content platform: Cloudflare Workers content backend (D1 + R2 + KV) + Next.js frontend, with a Blogger migration pipeline.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web -- --hostname 0.0.0.0",
    "build:web": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --import ./tests/ts-resolve.mjs --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --import ./tests/ts-resolve.mjs --test --watch tests/*.test.ts",
    "db:local:init": "node scripts/migrate.mjs --local",
    "db:remote:migrate": "node scripts/migrate.mjs --remote",
    "db:local:status": "node scripts/migrate.mjs --local --status",
    "media:local": "node scripts/upload-media.mjs --local",
    "seed:local": "node scripts/seed.mjs --local",
    "import:sample": "node scripts/import-blogger.mjs data/blogger/sample-export.xml",
    "verify:local": "node scripts/verify.mjs --local",
    "deploy": "bash scripts/deploy.sh",
    "smoke": "node scripts/smoke.mjs",
    "build:mobile": "npm run build --workspace @fg/mobile",
    "android:sync": "npm run android:sync --workspace @fg/mobile",
    "test:browser": "playwright test --config playwright.config.mts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0"
  }
}
